# Every shop setting, named like its site setting, so a site set's site settings and the classic static
# template's constants both end up in the settings each products_core plugin receives.
plugin.tx_productscore {
    settings {
        pids {
            storageFolder = {$products.pids.storageFolder}
            detailPage = {$products.pids.detailPage}
            basketPage = {$products.pids.basketPage}
            checkoutPage = {$products.pids.checkoutPage}
            orderHistoryPage = {$products.pids.orderHistoryPage}
            categoryPage = {$products.pids.categoryPage}
            withdrawalPage = {$products.pids.withdrawalPage}
            termsPage = {$products.pids.termsPage}
            withdrawalInstructionsPage = {$products.pids.withdrawalInstructionsPage}
            privacyPage = {$products.pids.privacyPage}
        }
        pricing {
            mode = {$products.pricing.mode}
            currency = {$products.pricing.currency}
            discountFieldMode = {$products.pricing.discountFieldMode}
            roundingMode = {$products.pricing.roundingMode}
            resellerPeriodPrecedence = {$products.pricing.resellerPeriodPrecedence}
            priceReductionLookbackDays = {$products.pricing.priceReductionLookbackDays}
        }
        tax {
            defaultCountry = {$products.tax.defaultCountry}
            rounding = {$products.tax.rounding}
        }
        order {
            numberPrefix = {$products.order.numberPrefix}
            storeClientIp = {$products.order.storeClientIp}
        }
        checkout {
            withdrawalPeriodDays = {$products.checkout.withdrawalPeriodDays}
            priceQuoteValiditySeconds = {$products.checkout.priceQuoteValiditySeconds}
            fields {
                salutation = {$products.checkout.fields.salutation}
                company = {$products.checkout.fields.company}
                telephone = {$products.checkout.fields.telephone}
                vatId = {$products.checkout.fields.vatId}
            }
            allowedCountries = {$products.checkout.allowedCountries}
            salutations = {$products.checkout.salutations}
            desiredDeliveryDate = {$products.checkout.desiredDeliveryDate}
        }
        withdrawal {
            assumedDeliveryDays = {$products.withdrawal.assumedDeliveryDays}
            timezone = {$products.withdrawal.timezone}
            instructionVariant = {$products.withdrawal.instructionVariant}
            returnCostBorneByTrader = {$products.withdrawal.returnCostBorneByTrader}
            trader {
                name = {$products.withdrawal.trader.name}
                address = {$products.withdrawal.trader.address}
                email = {$products.withdrawal.trader.email}
                phone = {$products.withdrawal.trader.phone}
                returnAddress = {$products.withdrawal.trader.returnAddress}
            }
        }
        stock {
            lowStockThreshold = {$products.stock.lowStockThreshold}
        }
        catalog {
            articleSwitchMode = {$products.catalog.articleSwitchMode}
        }
        payment {
            invoice {
                enabled = {$products.payment.invoice.enabled}
                excludedShipping = {$products.payment.invoice.excludedShipping}
            }
        }
        shipping {
            enabled = {$products.shipping.enabled}
            preselect = {$products.shipping.preselect}
            bulkySurcharge = {$products.shipping.bulkySurcharge}
            bulkyNoticeText = {$products.shipping.bulkyNoticeText}
            weightNoticeThreshold = {$products.shipping.weightNoticeThreshold}
            weightNoticeText = {$products.shipping.weightNoticeText}
        }
        handling {
            enabled = {$products.handling.enabled}
        }
        list {
            maximumNumberOfLinks = {$products.list.maximumNumberOfLinks}
            newItemDays = {$products.list.newItemDays}
        }
        email {
            senderEmail = {$products.email.senderEmail}
            senderName = {$products.email.senderName}
            merchantRecipient = {$products.email.merchantRecipient}
            agbAttachment = {$products.email.agbAttachment}
            orderBccRecipient = {$products.email.orderBccRecipient}
            orderStatusChanged {
                enabled = {$products.email.orderStatusChanged.enabled}
            }
        }
        invoice {
            pageType = {$products.invoice.pageType}
        }
        seo {
            pageTitleMode = {$products.seo.pageTitleMode}
        }
        session {
            requireCookieConsent = {$products.session.requireCookieConsent}
        }
        gdpr {
            invoiceRetentionDays = {$products.gdpr.invoiceRetentionDays}
        }
    }
}

# The catalogue and order records live in the configured storage folder.
plugin.tx_productscore.persistence.storagePid = {$products.pids.storageFolder}

# A plugin whose record argument points at nothing (a deleted product, a mistyped order uid) or that is
# called without its required argument answers with the site's "not found" page instead of an exception.
plugin.tx_productscore.mvc {
    showPageNotFoundIfTargetNotFoundException = 1
    showPageNotFoundIfRequiredArgumentIsMissingException = 1
}

products_invoice = PAGE
products_invoice {
    typeNum = {$products.invoice.pageType}
    config {
        disableAllHeaderCode = 1
        xhtml_cleaning = 0
        admPanel = 0
        debug = 0
        no_cache = 1
    }
    10 = USER
    10 {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        extensionName = ProductsCore
        pluginName = Invoice
        vendorName = GoldeneZeiten
        controller = InvoiceController
        action = download
        switchableControllerActions {
            InvoiceController {
                1 = download
            }
        }
    }
}

# Cache lifetime configuration for price periods
config.cache.all = tx_products_domain_model_priceperiod:{$products.pids.storageFolder}

# The product detail pages in the XML sitemap of EXT:seo (/?type=1533906435&tx_seo[config]=products). Without
# EXT:seo this configuration is never read. Products hidden from search engines are left out.
plugin.tx_seo.config.xmlSitemap.sitemaps.products {
    provider = TYPO3\CMS\Seo\XmlSitemap\RecordsXmlSitemapDataProvider
    config {
        table = tx_products_domain_model_product
        sortField = sorting
        lastModifiedField = tstamp
        additionalWhere = {#no_index} = 0
        pid = {$products.pids.storageFolder}
        url {
            pageId = {$products.pids.detailPage}
            fieldToParameterMap {
                uid = tx_productscore_productdetail[product]
            }
            additionalGetParameters {
                tx_productscore_productdetail.controller = Product
                tx_productscore_productdetail.action = show
            }
        }
    }
}
