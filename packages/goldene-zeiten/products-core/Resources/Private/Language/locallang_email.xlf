			</trans-unit>
			<trans-unit id="thank_you_for_order" resname="thank_you_for_order">
				<source>thank you for your order %s.</source>
			</trans-unit>
			<trans-unit id="order_total" resname="order_total">
				<source>Total</source>
			</trans-unit>
			<trans-unit id="best_regards" resname="best_regards">
				<source>Best regards,</source>
			</trans-unit>
			<trans-unit id="shop_team" resname="shop_team">
				<source>Shop Team</source>
			</trans-unit>
			<trans-unit id="merchant_notification_subject" resname="merchant_notification_subject">
				<source>New Order: %s</source>
			</trans-unit>
			<trans-unit id="merchant_notification_intro" resname="merchant_notification_intro">
				<source>A new order has been placed.</source>
			</trans-unit>
			<trans-unit id="order_number" resname="order_number">
				<source>Order Number</source>
			</trans-unit>
			<trans-unit id="customer_email" resname="customer_email">
				<source>Customer Email</source>
			</trans-unit>
			<trans-unit id="order_status_changed_subject" resname="order_status_changed_subject">
				<source>Order Status Updated: %s</source>
			</trans-unit>
			<trans-unit id="order_status_changed" resname="order_status_changed">
				<source>Order Status Updated</source>
			</trans-unit>
			<trans-unit id="status_changed_from_to" resname="status_changed_from_to">
				<source>The status of your order %s changed from "%s" to "%s".</source>
			</trans-unit>
			<trans-unit id="low_stock_warning_subject" resname="low_stock_warning_subject">
				<source>Low Stock Warning: %s</source>
			</trans-unit>
			<trans-unit id="low_stock_warning_intro" resname="low_stock_warning_intro">
				<source>A product/article has reached the low-stock threshold.</source>
			</trans-unit>
			<trans-unit id="remaining_stock" resname="remaining_stock">
				<source>Remaining stock: %d</source>
			</trans-unit>
			<trans-unit id="withdrawal_subject" resname="withdrawal_subject">
				<source>Withdrawal from order %s</source>
			</trans-unit>
			<trans-unit id="withdrawal_reason" resname="withdrawal_reason">
				<source>Reason given</source>
			</trans-unit>
			<trans-unit id="withdrawal_button_label" resname="withdrawal_button_label">
				<source>Withdraw from contract here</source>
			</trans-unit>
			<trans-unit id="withdrawal_notice_fully_excluded" resname="withdrawal_notice_fully_excluded">
				<source>All items of this order are exempt from the statutory right of withdrawal (personalized items, or digital content supplied immediately with your express consent), so the order cannot be withdrawn.</source>
			</trans-unit>
			<trans-unit id="withdrawal_notice_excluded_items" resname="withdrawal_notice_excluded_items">
				<source>The following items are exempt from the right of withdrawal and cannot be returned:</source>
			</trans-unit>
			<trans-unit id="withdrawal_merchant_excluded_items" resname="withdrawal_merchant_excluded_items">
				<source>Note: this order contains items exempt from the right of withdrawal:</source>
			</trans-unit>
			<trans-unit id="withdrawal_merchant_intro" resname="withdrawal_merchant_intro">
				<source>A customer has submitted a withdrawal statement for this order.</source>
			</trans-unit>
			<trans-unit id="withdrawal_customer_name" resname="withdrawal_customer_name">
				<source>Name</source>
			</trans-unit>
			<trans-unit id="withdrawal_submitted_at" resname="withdrawal_submitted_at">
				<source>Date and time of submission</source>
			</trans-unit>
			<trans-unit id="withdrawal_items_heading" resname="withdrawal_items_heading">
				<source>Items withdrawn from</source>
			</trans-unit>
			<trans-unit id="withdrawal_merchant_awaiting_return" resname="withdrawal_merchant_awaiting_return">
				<source>The goods had already been shipped. The order stays in the withdrawn status until you mark the returned goods as received.</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_subject" resname="withdrawal_acknowledgement_subject">
				<source>Acknowledgement of receipt of your withdrawal for order %s</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_heading" resname="withdrawal_acknowledgement_heading">
				<source>Acknowledgement of receipt of your withdrawal</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_intro" resname="withdrawal_acknowledgement_intro">
				<source>We have received your withdrawal statement. This email is the acknowledgement of receipt on a durable medium.</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_content" resname="withdrawal_acknowledgement_content">
				<source>Content of your withdrawal statement</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_statement" resname="withdrawal_acknowledgement_statement">
				<source>I hereby withdraw from my contract concerning the following items:</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_email" resname="withdrawal_acknowledgement_email">
				<source>Email address for this confirmation</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_conditional" resname="withdrawal_acknowledgement_conditional">
				<source>For the following items the right of withdrawal only applies as long as you have not unsealed them after delivery. Please return them sealed:</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_return_heading" resname="withdrawal_acknowledgement_return_heading">
				<source>Returning the goods</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_return" resname="withdrawal_acknowledgement_return">
				<source>Please send the goods back to the address below without undue delay and in any event not later than %s. The deadline is met if you send the goods back before it has expired.</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_return_cost_trader" resname="withdrawal_acknowledgement_return_cost_trader">
				<source>We bear the cost of returning the goods.</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_return_cost_customer" resname="withdrawal_acknowledgement_return_cost_customer">
				<source>You bear the direct cost of returning the goods.</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_no_return" resname="withdrawal_acknowledgement_no_return">
				<source>Your order had not been shipped yet, so there is nothing to send back.</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_refund_heading" resname="withdrawal_acknowledgement_refund_heading">
				<source>Refund</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_refund" resname="withdrawal_acknowledgement_refund">
				<source>We will reimburse all payments received from you for the withdrawn items, including the costs of standard delivery where you withdraw from the whole order, without undue delay and in any event not later than %s, using the same means of payment you used for the initial transaction. You will not incur any fees as a result of this reimbursement.</source>
			</trans-unit>
			<trans-unit id="withdrawal_acknowledgement_refund_withhold" resname="withdrawal_acknowledgement_refund_withhold">
				<source>We may withhold the reimbursement until we have received the goods back or you have supplied evidence of having sent them back, whichever is the earliest.</source>
			</trans-unit>
			<trans-unit id="withdrawal_datetime_format" resname="withdrawal_datetime_format">
				<source>Y-m-d H:i:s T</source>
			</trans-unit>
			<trans-unit id="billing_address" resname="billing_address">
				<source>Billing address</source>
			</trans-unit>
			<trans-unit id="delivery_address" resname="delivery_address">
				<source>Delivery address</source>
			</trans-unit>
			<trans-unit id="shipping_method" resname="shipping_method">
				<source>Shipping method</source>
			</trans-unit>
			<trans-unit id="payment_method" resname="payment_method">
				<source>Payment method</source>
			</trans-unit>
			<trans-unit id="payment_instructions" resname="payment_instructions">
				<source>Payment instructions</source>
			</trans-unit>
			<trans-unit id="customer_note" resname="customer_note">
				<source>Your comment</source>
			</trans-unit>
			<trans-unit id="vat_id" resname="vat_id">
				<source>VAT ID</source>
			</trans-unit>
		</body>
